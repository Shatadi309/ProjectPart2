<Window x:Class="Project_Part2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Project_Part2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <!-- start of parent grid-->

        <!--HOME grid.This grid displays the logo and the
        continue button
        -->

        <Grid x:Name="home_grid" Visibility="Visible" Background="Black">

            <!--Logo-->
            <Image
                Source="/logo.jpg"
                Height="200"
                Width="300"
                Margin="0,0,0,200"
       
                />

            <!--Welcome Message-->
            <TextBlock
                Text="Welcome! VANTA at your service. Click below to continue"
                Height="30"
                TextAlignment="Center"
                Margin="0,30,0,0"
                FontFamily="Arial Unicode MS"
                Foreground="GreenYellow"
                />

            <!--button to continue-->
            <Button
                Height="45"
                Width="250"
                Margin="0,200,0,0"
                Content="Continue"
                Click="proceed"
                Background="GreenYellow"
                />
        </Grid>

        <!--USERNAME grid to prompt user to login-->
        <Grid x:Name="username_grid" Visibility="Hidden" Background="Black">

            <!--Logo-->
            <Image
                Source="/logo.jpg"
                Height="200"
                Width="300"
                Margin="0,0,0,200"
                
                />

            <!--Hint message-->
            <TextBlock
                Text="Enter username"
                Height="25"
                Width="270"
                TextAlignment="Justify"
                Margin="0,30,0,0"
                FontFamily="Arial Unicode MS"
                Foreground="GreenYellow"
                
                />

            <!--Prompting username-->
            <TextBox
                Height="40"
                Width="270"
                TextAlignment="Center"
                Margin="0,100,0,0"
                FontFamily="Arial Unicode MS"
                x:Name="username_input"
                />

            <!--error message-->
            <TextBlock
                Text="Ensure username is entered"
                Height="25"
                Width="270"
                TextAlignment="Justify"
                Margin="0,180,0,0"
                Foreground="Blue"
                FontFamily="Arial Unicode MS"
                Background="GreenYellow"
                />

            <!--button to Sign In-->
            <Button
                Height="40"
                Width="270"
                Margin="0,250,0,0"
                Content="Sign In"
                Click="submit_name"
                Background="GreenYellow"
                />

        </Grid>

        <!--CHAT grid to handle chats between the AI bot
        and the user
        -->

        <Grid x:Name="chat_grid" Visibility="Hidden" Background="Black">

            <!--List view to display messages-->
            <ListView
                x:Name="chats"
                Height="300"
                Margin="0,0,0,130"
                Background="Black"
                />

            <!--Textbox to promt questions-->
            <TextBox
                x:Name="question"
                Height="50"
                Width="480"
                Margin="0,300,300,0"
                />

            <!--button to send-->
            <Button
                Height="45"
                Width="260"
                Margin="490,300,0,0"
                Content="send"
                Click="send"
                Background="GreenYellow"
                
          
                />
        </Grid>
            
        <!--task adding and viewing grid-->
        <Grid
            x:Name="task_grid"
            Visibility="Hidden"
            ><!--start of tasks_grid-->
            
            <!--ListView -->
            <ListView
                x:Name="chat"
                Height="350"
                Width="700"
                Margin="0,0,0,110"
                
                />
            
            <!--TextBox-->
            <TextBox
                Height="50"
                Width="250"
                Margin="0,110,350,0"
                x:Name="Question"
                />
            <!--Button to submit question-->
            <Button
                Height="50"
                Width="250"
                Margin="300,100,0,0"
                Content="Submit task"
                Click="submit_task"
                Background="GreenYellow"
                />


        </Grid> <!-- end of task grid-->

        <!--QUIZ grid to handle the cybersecurity mini quiz-->
        <Grid x:Name="quiz_grid" Visibility="Hidden" Background="Black">

            <!--Quiz Title-->
            <TextBlock
        x:Name="quiz_title"
        Text="Cybersecurity Mini-Quiz"
        Height="30"
        Width="750"
        TextAlignment="Center"
        Margin="0,5,0,0"
        FontFamily="Arial Unicode MS"
        FontSize="16"
        FontWeight="Bold"
        Foreground="GreenYellow"
        VerticalAlignment="Top"
        />

            <!--Question Type Label Multiple Choice / True or False-->
            <TextBlock
        x:Name="quiz_type_label"
        Text=""
        Height="20"
        Width="750"
        TextAlignment="Center"
        Margin="0,40,0,0"
        FontFamily="Arial Unicode MS"
        FontSize="11"
        Foreground="LightGreen"
        VerticalAlignment="Top"
        />

            <!--Question Number Label-->
            <TextBlock
        x:Name="quiz_number_label"
        Text=""
        Height="20"
        Width="750"
        TextAlignment="Center"
        Margin="0,58,0,0"
        FontFamily="Arial Unicode MS"
        FontSize="11"
        Foreground="GreenYellow"
        VerticalAlignment="Top"
        />

            <!--Score Label-->
            <TextBlock
        x:Name="quiz_score_label"
        Text="Score: 0"
        Height="20"
        Width="750"
        TextAlignment="Right"
        Margin="0,58,10,0"
        FontFamily="Arial Unicode MS"
        FontSize="11"
        Foreground="GreenYellow"
        VerticalAlignment="Top"
        />

            <!--Question Text-->
            <TextBlock
        x:Name="quiz_question_text"
        Text=""
        Height="50"
        Width="720"
        TextAlignment="Center"
        TextWrapping="Wrap"
        Margin="0,80,0,0"
        FontFamily="Arial Unicode MS"
        FontSize="13"
        Foreground="White"
        VerticalAlignment="Top"
        />

            <!--Option A Button-->
            <Button
        x:Name="btn_option_a"
        Height="35"
        Width="680"
        Margin="0,140,0,0"
        Content=""
        Click="quiz_option_a"
        Background="GreenYellow"
        FontFamily="Arial Unicode MS"
        VerticalAlignment="Top"
        />

            <!--Option B Button-->
            <Button
        x:Name="btn_option_b"
        Height="35"
        Width="680"
        Margin="0,182,0,0"
        Content=""
        Click="quiz_option_b"
        Background="GreenYellow"
        FontFamily="Arial Unicode MS"
        VerticalAlignment="Top"
        />

            <!--Option C Button-->
            <Button
        x:Name="btn_option_c"
        Height="35"
        Width="680"
        Margin="0,224,0,0"
        Content=""
        Click="quiz_option_c"
        Background="GreenYellow"
        FontFamily="Arial Unicode MS"
        VerticalAlignment="Top"
        />

            <!--Option D Button-->
            <Button
        x:Name="btn_option_d"
        Height="35"
        Width="680"
        Margin="0,266,0,0"
        Content=""
        Click="quiz_option_d"
        Background="GreenYellow"
        FontFamily="Arial Unicode MS"
        VerticalAlignment="Top"
        />

            <!--Feedback TextBlock shown after each answer-->
            <TextBlock
        x:Name="quiz_feedback"
        Text=""
        Height="45"
        Width="720"
        TextAlignment="Center"
        TextWrapping="Wrap"
        Margin="0,308,0,0"
        FontFamily="Arial Unicode MS"
        FontSize="12"
        Foreground="GreenYellow"
        VerticalAlignment="Top"
        />

            <!--Next Question Button-->
            <Button
        x:Name="btn_next"
        Height="35"
        Width="300"
        Margin="0,358,0,0"
        Content="Next Question"
        Click="quiz_next"
        Background="GreenYellow"
        FontFamily="Arial Unicode MS"
        Visibility="Hidden"
        VerticalAlignment="Top"
        />

            <!--Back to Chat Button-->
            <Button
        Height="35"
        Width="150"
        Margin="0,350,0,0"
        Content="Back to Chat"
        Click="quiz_back"
        Background="GreenYellow"
        FontFamily="Arial Unicode MS"
        VerticalAlignment="Top"
        />

        </Grid>
        <!--end of quiz grid-->

    </Grid> <!--end of parent grid-->

</Window>
